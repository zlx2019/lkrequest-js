   * upstream invokes a synchronous trait such as `RetryPolicy`, and resolves with its result.
   */
  export function syncCall(callback: (value: number) => Promise<number>, value: number, timeoutMs: number): Promise<number>
  /**
   * Calls the synchronous bridge on the JavaScript thread itself, which must fail at once
   * instead of deadlocking.
   */
  export function syncCallOnJsThread(callback: (value: number) => Promise<number>, value: number): number
}
