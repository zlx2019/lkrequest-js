  /** TLS ClientHello over TCP. */
  tlsProfile?: NativeTlsProfile
  /** HTTP/2 fingerprint. */
  h2Profile?: NativeH2Profile
  /** TCP fingerprint. */
  tcpFingerprint?: NativeTcpFingerprint
  /** TLS ClientHello inside QUIC. */
  quicFingerprint?: NativeTlsProfile
  /** QUIC / HTTP/3 fingerprint. */
  quicProfile?: NativeQuicProfile
}

/** Which ClientHello fields carry GREASE values; every switch defaults to off. */
export interface NativeGrease {
  /** In the cipher suites. */
  cipherSuite?: boolean
  /** As an extension. */
  extensions?: boolean
  /** In the supported groups. */
  supportedGroups?: boolean
  /** In the supported versions. */
  supportedVersions?: boolean
  /** In the signature algorithms. */
  signatureAlgorithms?: boolean
  /** In the key shares. */
  keyShare?: boolean
}

/** How outbound HTTP/2 DATA payloads are capped. */
export interface NativeH2DataFramePolicy {
  /** `browser_default`, `peer_max_frame_size`, `fixed_payload` or `socket_write_aligned`. */
  mode: string
  /** Byte count of the two sized modes. */
  size?: number
}

/** A hand-built HTTP/2 profile. */
export interface NativeH2ProfileOptions {
  /** SETTINGS entries, in order. */
  settings: Array<NativeH2Setting>
  /** Connection WINDOW_UPDATE increment. */
  windowUpdate: number
  /** Pseudo-header order: `method`, `authority`, `scheme`, `path`. */
  pseudoHeaderOrder: Array<string>
  /** Priority of the HEADERS frame. */
  headersPriority?: NativeHeadersPriority
  /** PRIORITY frames sent after the preface. */
  priorityFrames?: Array<NativePriorityFrame>
  /** Request priority mapping. */
  priorityConfig?: NativePriorityConfig
  /** Stream id of the first request on a connection: odd, from 1 to 2^31-1 (default 1). */
  initialStreamId?: number
}

/** One SETTINGS entry: a known setting by name, or any setting by its numeric id. */
export interface NativeH2Setting {
  /** Setting name such as `header_table_size`. */
  name?: string
  /** Numeric setting id, for settings without a name. */
  id?: number
  /** Setting value. */
  value: number
}

/** One frame of an HTTP/3 control stream. */
export interface NativeH3ControlFrame {
  /** Frame type. */
  frameType: bigint
  /** Frame payload. */
  payload: Buffer
}

/** What a client sent on its HTTP/3 control stream. */
export interface NativeH3ControlStream {
  /** Every frame, in order. */
  frames: Array<NativeH3ControlFrame>
  /** SETTINGS entries in the order sent, unknown and repeated ids included. */
  settings: Array<NativeH3Setting>
  /** PRIORITY_UPDATE frames, in order. */
  priorityUpdates: Array<NativeH3PriorityUpdate>
}

/** One HTTP/3 PRIORITY_UPDATE frame. */
export interface NativeH3PriorityUpdate {
  /** `0xf0700` for a request stream, `0xf0701` for a push. */
  frameType: bigint
  /** The stream or push whose priority is updated. */
  elementId: bigint
  /** The priority field value as sent, one character per byte. */
  fieldValue: string
}

/** One HTTP/3 SETTINGS entry. */
export interface NativeH3Setting {
  /** Setting identifier. */
  id: bigint
  /** Setting value. */
  value: bigint
}

/** Priority of the HEADERS frame. */
export interface NativeHeadersPriority {
  /** Stream the request depends on. */
  streamDependency: number
  /** Weight, 1 to 256 on the wire (stored minus one, 0 to 255). */
  weight: number
  /** Exclusive dependency. */
  exclusive: boolean
}

/** Periodic proxy health checks; durations in milliseconds. */
export interface NativeHealthCheckOptions {
  /** Time between checks (default 60000). */
  interval?: number
  /** Time limit of one check (default 5000). */
  timeout?: number
  /** Host the check connects to through each proxy (default `www.google.com`). */
  targetHost?: string
  /** Port the check connects to (default 443). */
  targetPort?: number
  /**
   * Probe MASQUE proxies by opening a real CONNECT-UDP tunnel to the target (needs
   * `masque`); without it they are skipped, neither credited nor blacklisted.
   */
  tunnelProbe?: boolean
  /** How to reach MASQUE proxies for the probe. */
  masque?: NativeMasqueOptions
}

/** An HTTPS (SVCB) record as a JavaScript resolver describes it. */
export interface NativeHttpsRecord {
  /** Application protocols the endpoint speaks, such as `h3`. */
  alpn?: Array<string>
  /** The protocol implied by the URL scheme is not available at this endpoint. */
  noDefaultAlpn?: boolean
  /** Name to connect to instead of the host. */
  target?: string
  /** Port to connect to instead of the URL's. */
  port?: number
  /** Encrypted Client Hello configuration list. */
  ech?: Uint8Array
  /** IPv4 addresses the endpoint is reachable at. */
  ipv4Hints?: Array<string>
  /** IPv6 addresses the endpoint is reachable at. */
  ipv6Hints?: Array<string>
}

/** TCP keep-alive settings; durations in milliseconds. */
export interface NativeKeepalive {
  /** Turn keep-alive on or off. */
  enabled: boolean
  /** Idle time before the first probe. */
  idle?: number
  /** Time between probes. */
  interval?: number
}

/** One log event. */
export interface NativeLogRecord {
  /** `error`, `warn`, `info`, `debug` or `trace`. */
  level: string
  /** Module path of the code that logged, for example `lkrequest::session`. */
  target: string
  /** The event's message. */
  message: string
  /** The event's other fields, formatted as text. */
  fields: Record<string, string>
  /** Milliseconds since the Unix epoch. */
  timestamp: number
}

/**
 * The outer hop to a MASQUE proxy. Trust is configured here, separately from the client's
 * TLS options, which only govern the tunneled connection to the origin.
 */
export interface NativeMasqueOptions {
  /** Server name for the proxy's certificate, instead of the proxy's host. */
  serverName?: string
  /** Extra trust anchors as PEM documents. */
  caPem?: Uint8Array[]
  /** Trust the operating system's certificate store too (default `true`). */
  useNativeCerts?: boolean
  /** Verify the proxy's certificate (default `true`). */
  rejectUnauthorized?: boolean
  /** How long an idle tunnel is kept, in milliseconds; `Infinity` keeps it (default 120000). */
  tunnelIdleTimeout?: number
  /** Idle tunnels kept at most; 0 removes the cap (default 256). */
  maxIdleTunnels?: number
}

/** Upstream's transport counters; all zero without the `telemetry` feature. */
export interface NativeMetricsSnapshot {
  /** Bytes read from the network. */
  bytesIn: number
  /** Bytes written to the network. */
  bytesOut: number
  /** Requests sent. */
  requestsTotal: number
  /** Requests that failed. */
  requestsFailed: number
  /** Connections open now. */
  activeConnections: number
  /** Connections opened so far. */
  totalConnections: number
}

/** The result of one request, as the facade receives it. */
export interface NativeOutcome {
  /** Set when the exchange produced a response. */
  response?: NativeResponse
  /** Set when the request failed. */
  error?: NativeError
}

/** How the ClientHello is padded. */
export interface NativePadding {
  /** `block_align`, `fixed_target` or `none`. */
  mode: string
  /** Smallest padded length, for `block_align`. */
  minLength?: number
  /** Block size, for `block_align`. */
  blockSize?: number
  /** Exact padded length, for `fixed_target`. */
  targetLength?: number
}

/** One `FormData` entry; exactly one of `text` and `data` is set. */
export interface NativePart {
  /** Field name. */
  name: string
  /** Value of a text field. */
  text?: string
  /** Content of a file field. */
  data?: Uint8Array
  /** File name of a file field. */
  filename?: string
  /** Media type of a file field. */
  contentType?: string
}

/** A browsing context the session-ticket cache is partitioned by. */
export interface NativePartitionContext {
  /** Schemeful top-level site, such as `https://example.com`. */
  topLevelSite: string
  /** Schemeful site of the frame making the request. */
  frameSite: string
  /** Transient partition nonce, for isolated contexts. */
  nonce?: string
  /** Opaque browser context, such as Firefox's origin attributes. */
  browserContext?: string
}

/** Connection pool statistics of a session. */
export interface NativePoolStats {
  /** Idle HTTP/1.1 connections. */
  h1Connections: number
  /** HTTP/2 connections. */
  h2Connections: number
  /** HTTP/3 connections. */
  h3Connections: number
  /** Connections counted against the limit, checked-out ones included. */
  total: number
  /** The connection limit; `Infinity` when there is none. */
  maxTotal: number
  /** Whether the limit is reached. */
  atCapacity: boolean
}

/** The outcome of preconnecting to one URL. */
export interface NativePreconnectResult {
  /** The URL as given. */
  url: string
  /** Set when the connection could not be established. */
  error?: NativeError
}

/** The outcome of prefetching one URL. */
export interface NativePrefetchResult {
  /** The URL as given. */
  url: string
  /** Whether a connection was established. */
  success: boolean
  /** Time spent, in milliseconds. */
  duration: number
  /** Why it failed, when it did. */
  error?: string
}

/** A request priority (RFC 9218): a preset name, or an urgency with an incremental flag. */
export interface NativePriority {
  /** `navigation`, `fetch`, `css`, `script`, `image` or `background`. */
  preset?: string
  /** Urgency from 0 (highest) to 7; larger values are clamped to 7. */
  urgency?: number
  /** Whether the response can be processed incrementally. */
  incremental?: boolean
}

/** How request priorities map onto HTTP/2. */
export interface NativePriorityConfig {
  /**
   * `chrome`, `firefox`, `safari18`, `safari26` or `default`; the other fields are ignored
   * when set. Absent when read back.
   */
  preset?: string
  /** Weight per urgency 0–7 (exactly eight values). */
  urgencyWeights?: Array<number>
  /** Exclusive stream dependencies. */
  exclusive?: boolean
  /** `flat`, `chain` or `priority_chain`. */
  streamDepPolicy?: string
  /** Send a `priority` header derived from the request priority. */
  autoPriorityHeader?: boolean
  /** Urgency of requests without a priority (0–7, default 3). */
  defaultUrgency?: number
  /** Whether requests without a priority are incremental. */
  defaultIncremental?: boolean
}

/** A PRIORITY frame sent after the preface. */
export interface NativePriorityFrame {
  /** Stream the frame is for. */
  streamId: number
  /** Stream it depends on. */
  dependency: number
  /** Weight (stored minus one, 0 to 255). */
  weight: number
  /** Exclusive dependency. */
  exclusive: boolean
}

/** Where and how long to probe a proxy; the time is in milliseconds. */
export interface NativeProbeOptions {
  /** Host to tunnel to through the proxy (default `www.google.com`). */
  host?: string
  /** Port to tunnel to (default 443). */
  port?: number
  /** Time limit of the check (default 5000). */
  timeout?: number
}

/** How a proxy health check ended. */
export interface NativeProbeOutcome {
  /** Time the tunnel took to open, in milliseconds. */
  latency?: number
  /** Why the tunnel could not be opened. */
  error?: NativeError
}

/**
 * A protocol policy: a preset, adjusted axis by axis. Unset axes keep the value of the
 * starting policy.
 */
export interface NativeProtocolPolicy {
  /**
   * Preset to start from: `chrome_standard`, `chrome_conservative`, `crawler_throughput` or
   * `h3_strict`. Without one, the policy in force at the level being configured is the start.
   */
  preset?: string
  /** `h2_only`, `h3_only`, `acquire_h3_when_viable` or `reuse_existing_protocol`. */
  intent?: string
  /** `reuse_existing_first`, `establish_best_available` or `race`. */
  acquisition?: string
  /** Parameters of `acquisition: "race"`. */
  race?: NativeRacePolicy
  /** `off`, `probe_only`, `probe_and_migrate` or `force_for_new_requests`. */
  upgrade?: string
  /** `allow_fallback`, `allow_fallback_on_network_errors` or `no_fallback`. */
  fallback?: string
}

/** Options of a proxy pool. */
export interface NativeProxyPoolOptions {
  /** Most proxies leased out at once. */
  maxConcurrent?: number
  /** `round_robin` (default) or `random`. */
  rotation?: string
  /** Bad-proxy detection. */
  badProxy?: NativeBadProxyOptions
  /** Periodic health checks. */
  healthCheck?: NativeHealthCheckOptions
  /** Proxies a function source keeps ready, made up ahead of `acquire()`. */
  proxyBuffer?: number
}

/** Parameters of a TCP-versus-QUIC race; unset ones keep upstream's Chrome-like values. */
export interface NativeRacePolicy {
  /** Start a TCP attempt. */
  tcp?: boolean
  /** Start a QUIC attempt. */
  quic?: boolean
  /** Delay before the TCP attempt starts, in milliseconds. */
  tcpDelay?: number
  /** Delay before the QUIC attempt starts, in milliseconds. */
  quicDelay?: number
  /** Race only when the route has already advertised HTTP/3. */
  onlyWhenH3Advertised?: boolean
}

/** A randomization policy. */
export interface NativeRandomize {
  /** `off`, `extension_order`, `recombine` or `full`. */
  mode: string
  /** Layers a synthetic policy varies: `tls`, `h2`, `quic` (default all). */
  layers?: Array<string>
  /** Signature algorithm floor of a synthetic policy: `universal` or `preset_family`. */
  negotiability?: string
  /** A custom signature algorithm floor, instead of `negotiability`. */
  negotiabilitySigAlgs?: Array<number>
}

/** One redirect hop. */
export interface NativeRedirect {
  /** URL that answered with the redirect. */
  url: string
  /** Redirect status code. */
  status: number
  /** Headers of the redirect response, as flat name/value pairs. */
  headers: Array<string>
  /** Absolute URL the redirect pointed to. */
  location: string
}

/** Request options, flattened by the facade. Pairs are flat `[name, value, ...]` lists. */
export interface NativeRequest {
  /** HTTP method, already upper-cased where the facade normalizes it. */
  method: string
  /** Absolute URL (the facade has already applied `baseUrl`). */
  url: string
  /** Request headers in send order. */
  headers?: Array<string>
  /** Query parameters appended to the URL. */
  query?: Array<string>
  /** Cookies merged with the session's cookie jar. */
  cookies?: Array<string>
  /** Cookies that replace jar cookies of the same name for this request. */
  cookieOverride?: Array<string>
  /** Total time limit for this request, in milliseconds. */
  timeout?: number
  /** Token for `Authorization: Bearer`. */
  bearerAuth?: string
  /** User name for `Authorization: Basic`. */
  basicAuthUser?: string
  /** Password for `Authorization: Basic`. */
  basicAuthPassword?: string
  /** `false` keeps the body compressed as received. */
  decompress?: boolean
  /** Content codings to advertise for this request. */
  acceptEncoding?: Array<string>
  /** Header order for this request, overriding the session's. */
  headerOrder?: Array<string>
  /** Cookie order for this request, overriding the session's. */
  cookieOrder?: Array<string>
  /** Header order for this request over HTTP/3, overriding the session's. */
  h3HeaderOrder?: Array<string>
  /** Request priority (RFC 9218). */
  priority?: NativePriority
  /** Weight byte of the HTTP/2 HEADERS priority (0 to 255, the weight minus one). */
  h2PriorityWeight?: number
  /** HTTP version preference for this request. */
  preferredHttpVersion?: string
  /** Whether the request may be replayed (0-RTT, retries). */
  idempotency?: string
  /** Protocol policy for this request: a preset, adjusted axis by axis. */
  protocolPolicy?: NativeProtocolPolicy
  /** HTTP/2 versus HTTP/3 intent for this request. */
  httpIntent?: string
  /** Proxy URL for this request, overriding the session's. */
  proxy?: string
}

/** A buffered response. */
export interface NativeResponse {
  /** HTTP status code. */
  status: number
  /** Canonical reason phrase of the status; upstream does not keep the one on the wire. */
  statusText: string
  /** Final URL, after redirects. */
  url: string
  /** `"1.0"`, `"1.1"`, `"2.0"`, `"3.0"`, or `""` when unknown (Node's `httpVersion` style). */
  httpVersion: string
  /** Headers as flat name/value pairs: lower-case names, duplicates kept, upstream order. */
  headers: Array<string>
  /** Redirects followed before this response, oldest first. */
  history: Array<NativeRedirect>
  /** Phase timings and transport details. */
  diagnostics: NativeDiagnostics
  /** Wall-clock time of the whole exchange, in milliseconds. */
  elapsed: number
  /** Decompressed body, handed over without a copy. */
  body: Buffer
}

/** Whether TLS session tickets are cached and offered as PSKs. */
export interface NativeResumptionPolicy {
  /** `browser_default`, `disabled` or `enabled`. */
  mode: string
  /** Tickets kept per server; set exactly when `mode` is `enabled`. */
  maxTicketsPerServer?: number
}

/** A built-in retry strategy with its parameters; durations in milliseconds. */
export interface NativeRetryStrategy {
  /** `exponential` or `fixed`. */
  strategy: string
  /** Retries before giving up (default 3). */
  maxRetries?: number
  /** First delay of the exponential strategy (default 1000). */
  baseDelay?: number
  /** Largest delay of the exponential strategy (default 30000). */
  maxDelay?: number
  /** Randomize the exponential delays (default `true`). */
  jitter?: boolean
  /** Delay of the fixed strategy (default 1000). */
  interval?: number
}

/** Session options, flattened by the facade. Durations are in milliseconds. */
export interface NativeSessionOptions {
  /** `false` returns 3xx responses as they are instead of following them. */
  followRedirects?: boolean
  /** Redirects to follow before failing with `TooManyRedirectsError` (default 10). */
  maxRedirects?: number
  /** Content codings to advertise in `Accept-Encoding`. */
  acceptEncoding?: Array<string>
  /** Upper bound on connections this session keeps open. */
  maxConnections?: number
  /** How long an idle pooled connection is kept. */
  idleTimeout?: number
  /** Header order for HTTP/1.1 and HTTP/2 requests, overriding the client's. */
  headerOrder?: Array<string>
  /** Order of cookies in the `Cookie` header, overriding the client's. */
  cookieOrder?: Array<string>
  /** Header order for HTTP/3 requests, overriding the client's. */
  h3HeaderOrder?: Array<string>
  /**
   * HTTP version preference: `auto`, `http1_only`, `http2_only`, `http3_only` or
   * `http3_with_fallback`.
   */
  preferredHttpVersion?: string
  /** Protocol policy, overriding the client's: a preset, adjusted axis by axis. */
  protocolPolicy?: NativeProtocolPolicy
  /** HTTP/2 versus HTTP/3 intent, applied on top of the protocol policy. */
  httpIntent?: string
  /** How an origin whose QUIC connection failed is avoided. */
  brokenQuicPolicy?: NativeBrokenQuicPolicy
  /** HTTP/3 protocol-error retries: `safe` (default) or `chrome_155_protocol_errors`. */
  h3RetryMode?: string
  /** Refuse `http://` URLs. */
  httpsOnly?: boolean
  /** Browsing context the session-ticket cache is partitioned by. */
  networkPartitionContext?: NativePartitionContext
  /** Encrypted Client Hello configuration list, overriding the client's. */
  ech?: Uint8Array
  /** A built-in retry strategy. */
  retry?: NativeRetryStrategy
  /** A JavaScript retry policy, resolving with a delay in milliseconds or `null`. */
  retryFn?: (attempt: number, error: NativeError | null, status: number | null) => Promise<number | null>
}

/** Options of a session pool. */
export interface NativeSessionPoolOptions {
  /** Largest number of sessions alive at once. */
  maxSessions?: number
  /** How long an idle session is kept, in milliseconds. */
  idleTimeout?: number
  /** `round_robin` (default) or `random`. */
  rotation?: string
  /** Bad-proxy detection. */
  badProxy?: NativeBadProxyOptions
  /** Periodic health checks. */
  healthCheck?: NativeHealthCheckOptions
  /** Proxies a function source keeps ready, made up ahead of `acquire()`. */
  proxyBuffer?: number
}

/** Session pool statistics. */
